@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- Font Awesome for icons -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js" crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            const doctorSelect = $('#doctorSelect');
            const appointmentDateInput = $('#appointmentDate');
            const availableSlotsSelect = $('#availableSlots');
            const slotLoadingMessage = $('#slotLoadingMessage');
            const slotErrorMessage = $('#slotErrorMessage');
            const finalAppointmentDateTime = $('#finalAppointmentDateTime');

            // Safely get the initial ISO date string. JSON.parse will convert 'null' string to JS null.
            const initialAppointmentDateTimeISO = JSON.parse('@Html.Raw(initialAppointmentDateTimeForJs)');
            let initialFormattedTime = ''; // This will store the "hh:mm tt" part for matching

            // Helper function to format a Date object to "hh:mm tt"
            function formatTimeForDisplay(date) {
                let hours = date.getHours();
                let minutes = date.getMinutes();
                const ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12;
                hours = hours ? hours : 12; // the hour '0' should be '12'
                minutes = minutes < 10 ? '0' + minutes : minutes;
                return hours + ':' + minutes + ' ' + ampm;
            }

            // Only attempt to format if initialAppointmentDateTimeISO is not null
            if (initialAppointmentDateTimeISO !== null) {
                const dateObj = new Date(initialAppointmentDateTimeISO);
                if (!isNaN(dateObj.getTime())) { // Check if date parsing was successful
                    initialFormattedTime = formatTimeForDisplay(dateObj);
                }
            }

            // Function to display custom Bootstrap alert modal
            function showCustomAlert(title, message) {
                $('#customAlertModalLabel').text(title);
                $('#customAlertModalBody').html(message);
                var modal = new bootstrap.Modal(document.getElementById('customAlertModal'));
                modal.show();
            }

            // Function to load available slots via AJAX
            async function loadAvailableSlots() {
                const doctorId = doctorSelect.val();
                const selectedDate = appointmentDateInput.val(); // YYYY-MM-DD format

                // If no doctor or date is selected, simply reset and exit
                if (!doctorId || doctorId === "" || !selectedDate || selectedDate === "") {
                    availableSlotsSelect.empty().append('<option value="">-- Select Doctor and Date --</option>').prop('disabled', true);
                    slotLoadingMessage.addClass('d-none');
                    slotErrorMessage.text('').addClass('d-none');
                    return;
                }

                availableSlotsSelect.empty().append('<option value="">-- Loading Slots --</option>').prop('disabled', true);
                slotErrorMessage.text('').addClass('d-none');
                slotLoadingMessage.removeClass('d-none');

                try {
                    const response = await $.ajax({
                        url: '@Url.Action("GetAvailableSlots", "Appointment")',
                        type: 'GET',
                        data: {
                            doctorId: doctorId,
                            selectedDate: selectedDate
                        }
                    });

                    slotLoadingMessage.addClass('d-none');

                    if (response.success && response.slots && response.slots.length > 0) {
                        availableSlotsSelect.empty();

                        let hasRealSlots = false;
                        if (!(response.slots.length === 1 && response.slots[0] === "No slots available")) {
                             availableSlotsSelect.append('<option value="">-- Select Time Slot --</option>');
                             hasRealSlots = true;
                        }

                        $.each(response.slots, function (index, slot) {
                            const trimmedSlot = slot.trim();
                            availableSlotsSelect.append($('<option></option>').val(trimmedSlot).text(trimmedSlot));
                        });

                        availableSlotsSelect.prop('disabled', false);

                        // Attempt to pre-select the initial time
                        if (hasRealSlots && initialFormattedTime) {
                            const optionToSelect = availableSlotsSelect.find('option[value="' + initialFormattedTime + '"]');
                            if (optionToSelect.length > 0) {
                                availableSlotsSelect.val(initialFormattedTime);
                            } else {
                                availableSlotsSelect.val("");
                            }
                        } else if (availableSlotsSelect.find('option[value=""]').length > 0) {
                             availableSlotsSelect.val("");
                        }


                    } else if (response.success === false) {
                        availableSlotsSelect.empty().append('<option value="">-- Error Loading Slots --</option>');
                        availableSlotsSelect.prop('disabled', true);
                        slotErrorMessage.text(response.message || "An error occurred on the server.").removeClass('d-none');
                    } else {
                        availableSlotsSelect.empty().append('<option value="">-- No Slots Available --</option>');
                        availableSlotsSelect.prop('disabled', true);
                        slotErrorMessage.text("No slots found for this date and doctor.").removeClass('d-none');
                    }
                } catch (xhr, status, error) {
                    slotLoadingMessage.addClass('d-none');
                    availableSlotsSelect.empty().append('<option value="">-- Error Loading Slots --</option>');
                    availableSlotsSelect.prop('disabled', true);

                    let errorMessage = 'Error loading slots. Please try again.';
                    try {
                        const errorResponse = JSON.parse(xhr.responseText);
                        if (errorResponse && errorResponse.message) {
                            errorMessage = errorResponse.message;
                        } else if (xhr.status === 404) {
                            errorMessage = "Doctor or slots endpoint not found. Verify URL or server status.";
                        } else if (xhr.status === 400) {
                            errorMessage = "Invalid request for slots. Check parameters.";
                        }
                    } catch (e) { /* non-JSON error response */ }
                    slotErrorMessage.text(errorMessage).removeClass('d-none');
                }
            }

            // Combine date and time before form submission
            $('form').on('submit', function () {
                const datePart = appointmentDateInput.val();
                const timePart = availableSlotsSelect.val();

                if (datePart && timePart && timePart !== "" && timePart !== "-- Select Time Slot --" && timePart !== "No slots available" && timePart !== "-- Error Loading Slots --") {
                    finalAppointmentDateTime.val(`${datePart} ${timePart}`);
                } else {
                    finalAppointmentDateTime.val('');
                    showCustomAlert('Selection Required', 'Please select an available time slot before saving.');
                    return false;
                }
            });

            // Attach event listeners
            doctorSelect.on('change', loadAvailableSlots);
            appointmentDateInput.on('change', loadAvailableSlots);

            // Initial load of available slots when the page loads
            const initialDoctorIdValue = doctorSelect.val();
            const initialDateValue = appointmentDateInput.val();

            if (initialDoctorIdValue && initialDateValue) {
                loadAvailableSlots();
            }
        });
    </script>
    <style>
        /* Add some styling for the select inputs to make them rounded, similar to other inputs */
        .form-control.rounded-pill, .form-select.rounded-pill {
            border-radius: 50rem !important;
            padding-left: 1.25rem;
            padding-right: 1.25rem;
        }

        /* Adjust placeholder font style if needed */
        select.form-control:invalid {
            color: #6c757d; /* grey out default option */
        }
    </style>
}
